# Copia este archivo a `.env.local` (desarrollo) o configúralo en el hosting (staging/producción).

# Origen de datos: "memory" (demo sin backend, por defecto) o "supabase".
VITE_DATA_SOURCE=memory

# Solo con VITE_DATA_SOURCE=supabase. La clave anon es pública por diseño (la protege RLS).
# NUNCA pongas aquí la clave service_role: la app la rechaza al arrancar.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
